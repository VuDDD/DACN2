# Retina Medical AI Platform - Environment Configuration

# Application
PROJECT_NAME="Retina Medical AI Platform"
API_V1_STR="/api"
SECRET_KEY="vkuretina-medical-ai-super-secret-key-2026-production"
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# Database Configuration (PostgreSQL)
# Local standalone: sqlite:///./retina_medical.db
# Docker Compose: postgresql://retina_user:retina_pass@postgres:5432/retina_db
DATABASE_URL=sqlite:///./retina_medical.db
POSTGRES_USER=retina_user
POSTGRES_PASSWORD=retina_pass
POSTGRES_DB=retina_db
POSTGRES_PORT=5432

# Redis & Celery
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# MinIO Object Storage
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET_NAME=retina-medical
MINIO_SECURE=False

# Local Storage Fallback
STORAGE_DIR=./backend_storage

# AI Inference & Hardware
DEVICE=auto # 'auto', 'cuda', 'cpu'
IDRID_CHECKPOINT_DIR=./ai/checkpoints
DRIVE_CHECKPOINT_DIR=./ai/checkpoints
